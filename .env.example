# ─────────────────────────────────────────────────────────────────────
# Mbo portal — full-stack deploy configuration.
# Copy to `.env` on the server (or paste into Coolify's env vars):
#     cp .env.example .env
# Used by `docker compose up -d --build` and by Coolify for the
# Docker Compose resource.
# ─────────────────────────────────────────────────────────────────────

# ── Domains (point DNS A records to the VPS) ─────────────────────────
DOMAIN=mboempowerment.com
API_DOMAIN=back.mboempowerment.com

# ── Frontend ─────────────────────────────────────────────────────────
# Internal URL is correct for the all-in-one stack. For a Render-hosted
# frontend, use https://back.mboempowerment.com
BACKEND_URL=http://backend:8080
# Public API origin (baked into the build for media file URLs)
NEXT_PUBLIC_API_URL=https://back.mboempowerment.com

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_NAME=mbo_portal_v2
DB_USER=postgres
DB_PASSWORD=change-me

# ── Django ───────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
NIN_HASH_PEPPER=change-me
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=back.mboempowerment.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://www.mboempowerment.com,https://mboempowerment.com,https://*.onrender.com
CSRF_TRUSTED_ORIGINS=https://www.mboempowerment.com,https://mboempowerment.com,https://*.onrender.com
PORTAL_URL=https://mboempowerment.com

# ── Cross-site cookie auth ───────────────────────────────────────────
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None
# Caddy terminates TLS in front of Django; keep True.
SECURE_SSL_REDIRECT=True

# ── Celery (broker is injected by compose) ───────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ── Integrations (real credentials in production) ────────────────────
BREVO_API_KEY=
BREVO_MOCK_MODE=False
BREVO_SENDER_EMAIL=no-reply@mboempowerment.com
BREVO_SENDER_NAME=Mbo Youth Empowerment
PAYSTACK_SECRET_KEY=
PAYSTACK_MOCK_MODE=False
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=dwn6p3qmd
SUPPORT_EMAIL=support@mboempowerment.com